# SPDX-License-Identifier: GPL-3.0-or-later

import json
import os
import sys

import agent


agent.set_weight(os.path.basename(__file__), 0)
request = json.load(sys.stdin)

# The provisioning step reads the two values as lines before sending them to
# the DC container. A line break would shift or truncate those credentials.
for field in ("adminuser", "adminpass"):
    if any(char in request[field] for char in "\r\n"):
        print("Domain join credentials cannot contain line breaks.", file=sys.stderr)
        agent.set_status("validation-failed")
        json.dump([{
            "field": field,
            "parameter": field,
            "value": "",
            "error": "invalid_join_credentials_linebreak",
        }], sys.stdout)
        sys.exit(2)
    if "\x00" in request[field] or (field == "adminuser" and "\t" in request[field]):
        print("Domain join credentials contain an unsupported control character.", file=sys.stderr)
        agent.set_status("validation-failed")
        json.dump([{
            "field": field,
            "parameter": field,
            "value": "",
            "error": "invalid_join_credentials_control_character",
        }], sys.stdout)
        sys.exit(2)
