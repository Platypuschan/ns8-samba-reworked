import json
import os
import sys

import agent


request = json.load(sys.stdin)
module_id = os.environ["MODULE_ID"]
realm = request["realm"].upper()
domain = realm.lower()

if any(char in request["ldapservice_password"] for char in "\r\n"):
    print("The ldapservice password cannot contain a line break.", file=sys.stderr)
    agent.set_status("validation-failed")
    json.dump([{
        "field": "ldapservice_password",
        "parameter": "ldapservice_password",
        "value": "",
        "error": "invalid_environment_linebreak",
    }], sys.stdout)
    sys.exit(2)

agent.set_env("SERVER_ROLE", "dc")
agent.set_env("PROVISION_TYPE", "join-domain")
agent.set_env("PROVISION_MODE", "join-remote-domain")
agent.set_env("REALM", realm)
agent.set_env("DOMAIN", domain)
agent.set_env("NBDOMAIN", request["nbdomain"].upper())
agent.set_env("NBALIAS", request.get("nbalias", ""))
agent.set_env("HOSTNAME", request["hostname"].lower() + "." + domain)
agent.set_env("IPADDRESS", request["ipaddress"])
agent.set_env("JOINADDRESS", request["joinaddress"])
agent.set_env("SVCUSER", "ldapservice")
agent.set_env("SVCPASS", request["ldapservice_password"])

with agent.redis_connect(privileged=True) as rdb:
    # 03validate_remote rejects the cluster VPN for a remote DC.
    agent.unset_env("PREFIXLEN")
    rdb.sadd(f"module/{module_id}/flags", "file_server")
