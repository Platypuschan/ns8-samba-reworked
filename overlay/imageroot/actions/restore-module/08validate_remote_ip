import ipaddress
import json
import os
import sys

import agent


agent.set_weight(os.path.basename(__file__), 0)
request = json.load(sys.stdin)
if request["environment"].get("PROVISION_MODE") != "join-remote-domain":
    sys.exit(0)

# Upstream 06copyenv substitutes the node's WireGuard IP when the backed-up
# address is unavailable. A remote DC cannot advertise that address to its
# surviving peer or to clients in the other cluster.
address = os.getenv("IPADDRESS", "")
with agent.redis_connect(use_replica=True) as rdb:
    cluster_network = ipaddress.ip_network(rdb.get("cluster/network"), strict=False)

if not address or ipaddress.ip_address(address) in cluster_network:
    print(
        "Remote DC restore needs an available non-VPN IP address on the target "
        "node. Assign the original address or restore on a suitable node.",
        file=sys.stderr,
    )
    agent.set_status("validation-failed")
    json.dump(
        [{"field": "environment", "parameter": "IPADDRESS", "value": address,
          "error": "remote_dc_restore_requires_lan_ip"}],
        sys.stdout,
    )
    sys.exit(2)
