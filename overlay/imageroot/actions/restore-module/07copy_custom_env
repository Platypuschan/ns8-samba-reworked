import json
import sys

import agent


environment = json.load(sys.stdin)["environment"]
if environment.get("PROVISION_MODE") == "join-remote-domain":
    raise SystemExit("Remote DC restore is unsafe and must be rejected before copying environment")

for key in (
    "PROVISION_MODE",
    "JOINADDRESS",
    "NTFY_REPLICATION_ENABLED",
    "NTFY_REPLICATION_FAILURE_THRESHOLD",
    "NTFY_REPLICATION_BASE_URL",
    "NTFY_REPLICATION_TOPIC",
    "NTFY_REPLICATION_TOKEN",
):
    if key in environment:
        agent.set_env(key, environment[key])
