# SPDX-License-Identifier: GPL-3.0-or-later

import json
import os
import sys

import agent


agent.set_weight(os.path.basename(__file__), 0)
environment = json.load(sys.stdin)["environment"]
if environment.get("PROVISION_MODE") == "join-remote-domain":
    print(
        "Restoring a remote-joined DC would create a divergent copy of a live AD domain. "
        "Install a fresh DC and join the surviving domain instead.",
        file=sys.stderr,
    )
    agent.set_status("validation-failed")
    json.dump(
        [{"field": "environment", "parameter": "PROVISION_MODE", "value":
          "join-remote-domain", "error": "remote_dc_restore_unsupported"}],
        sys.stdout,
    )
    sys.exit(2)
