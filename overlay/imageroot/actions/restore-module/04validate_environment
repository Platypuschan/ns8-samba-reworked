import json
import os
import sys

import agent


agent.set_weight(os.path.basename(__file__), 0)
environment = json.load(sys.stdin)["environment"]
for key, value in environment.items():
    if any(char in key or char in value for char in "\r\n"):
        print("Backup environment contains a line break and cannot be restored.",
              file=sys.stderr)
        agent.set_status("validation-failed")
        json.dump([{
            "field": "environment",
            "parameter": key if "\r" not in key and "\n" not in key else "environment",
            "value": "",
            "error": "invalid_environment_linebreak",
        }], sys.stdout)
        sys.exit(2)
