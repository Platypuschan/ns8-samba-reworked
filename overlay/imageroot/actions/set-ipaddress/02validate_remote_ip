import ipaddress
import json
import os
import sys

import agent


agent.set_weight(os.path.basename(__file__), 0)
if os.getenv("PROVISION_MODE") == "join-remote-domain":
    address = json.load(sys.stdin)["ipaddress"]
    with agent.redis_connect() as rdb:
        cluster_network = ipaddress.ip_network(rdb.get("cluster/network"), strict=False)
    if ipaddress.ip_address(address) in cluster_network:
        print("A remote DC cannot use the NS8 cluster VPN address.", file=sys.stderr)
        agent.set_status("validation-failed")
        json.dump([{
            "field": "ipaddress",
            "parameter": "ipaddress",
            "value": address,
            "error": "dc_vpn_address_forbidden",
        }], sys.stdout)
        sys.exit(2)
